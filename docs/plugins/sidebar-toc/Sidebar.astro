---
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';

const route = Astro.locals.starlightRoute;
const { sidebar, toc } = route;
const pageId: string = route.id ?? route.entry?.id ?? '';

// The pages whose list starts hidden come from the plugin's `collapsed` option, which it carries in a <meta> tag.
const collapsedPages = (
	route.head.find((tag) => tag.tag === 'meta' && tag.attrs?.name === 'sidebar-toc-collapsed')?.attrs?.content ?? ''
)
	.toString()
	.split(',')
	.filter(Boolean);
const startCollapsed = collapsedPages.some((page) => (page.endsWith('/') ? pageId.startsWith(page) : pageId === page));

// Starlight puts a page-title entry first, and nests headings deeper than the
// minimum level under it. Both are lifted out so the list holds only headings.
const items = (toc?.items ?? []).flatMap((item) =>
	item.slug === '_top' ? item.children : [item],
);
---

<SidebarPersister>
	<SidebarSublist sublist={sidebar} />
</SidebarPersister>

<div class="md:sl-hidden">
	<MobileMenuFooter />
</div>

{
	items.length > 0 && (
		<script
			type="application/json"
			id="sidebar-toc-data"
			data-page={pageId}
			data-collapsed={String(startCollapsed)}
			set:html={JSON.stringify(items)}
		/>
	)
}

<script>
	interface Item {
		slug: string;
		text: string;
		children: Item[];
	}

	const dataEl = document.getElementById('sidebar-toc-data');
	const current = document.querySelector('#starlight__sidebar a[aria-current="page"]');

	function render(items: Item[]): HTMLUListElement {
		const ul = document.createElement('ul');
		ul.className = 'sidebar-toc';
		for (const item of items) {
			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = `#${item.slug}`;
			a.textContent = item.text;
			li.append(a);
			if (item.children.length > 0) li.append(render(item.children));
			ul.append(li);
		}
		return ul;
	}

	if (dataEl && current) {
		const list = render(JSON.parse(dataEl.textContent || '[]'));

		// The button shows or hides the list. A reader's choice is kept per page; without one, the page's default applies.
		const storeKey = `sidebar-toc:${dataEl.dataset.page ?? ''}`;
		const button = document.createElement('button');
		button.type = 'button';
		button.className = 'sidebar-toc-toggle';
		button.setAttribute('aria-label', 'Show or hide the headings of this page');
		// The path is Starlight's right-caret icon, the one its sidebar groups show.
		button.innerHTML =
			'<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="m14.83 11.29-4.24-4.24a1 1 0 1 0-1.42 1.41L12.71 12l-3.54 3.54a1 1 0 0 0 0 1.41 1 1 0 0 0 .71.29 1 1 0 0 0 .71-.29l4.24-4.24a1.002 1.002 0 0 0 0-1.42Z"/></svg>';
		const setCollapsed = (collapsed: boolean, remember: boolean) => {
			list.hidden = collapsed;
			button.setAttribute('aria-expanded', String(!collapsed));
			button.title = collapsed ? 'Show the headings of this page' : 'Hide the headings of this page';
			if (!remember) return;
			try {
				localStorage.setItem(storeKey, collapsed ? 'hidden' : 'shown');
			} catch {
				// The choice is lost with the page when the browser blocks storage.
			}
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(storeKey);
		} catch {
			// Storage blocked: the page's default applies.
		}
		setCollapsed(saved ? saved === 'hidden' : dataEl.dataset.collapsed === 'true', false);
		button.addEventListener('click', () => setCollapsed(!list.hidden, true));
		current.after(button, list);

		// Marks the last heading that has scrolled past the top of the page.
		const links = [...list.querySelectorAll<HTMLAnchorElement>('a')];
		const headings = links.map((a) => document.getElementById(a.hash.slice(1)));
		let active: HTMLAnchorElement | null = null;
		let queued = false;

		const update = () => {
			queued = false;
			const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
			let next: HTMLAnchorElement | null = null;
			headings.forEach((h, i) => {
				if (h && h.getBoundingClientRect().top <= offset + 1) next = links[i];
			});
			if (next === active) return;
			active?.classList.remove('is-active');
			next?.classList.add('is-active');
			active = next;
		};

		addEventListener('scroll', () => {
			if (!queued) {
				queued = true;
				requestAnimationFrame(update);
			}
		});
		update();
	}
</script>
